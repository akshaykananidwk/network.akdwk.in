# Local configuration & secrets — NEVER commit
/config/config.php
/config/*.local.php
/config/.env
/.env
/.env.local

# Runtime state
/storage/logs/*
/storage/cache/*
/storage/backups/*
/storage/updates/*
/storage/tmp/*
/storage/keys/*
/storage/maintenance.flag
!/storage/*/.gitkeep

# User content
/uploads/*
!/uploads/.gitkeep

# Installer lock
/install/install.lock

# Build output
/services/*/bin/
/services/*/dist/
*.exe
*.test

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Field kit build output — binaries are built on demand, never committed.
/services/kit/dist/
/services/kit/pack/

# The Windows test pack IS committed: a tester needs one URL to download, and
# a release asset I cannot create from here is no use to them.
!/services/kit/akconnect-windows-test-pack.zip
