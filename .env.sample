# Optional environment overrides. config/config.php wins unless a value is null there.
# This file is OPTIONAL — the installer writes config/config.php, which is authoritative.
#
# Copy it to config/.env, NOT to the web root: config/ is denied as a whole
# directory by the shipped .htaccess files, whereas a root .env is protected
# only by a per-file rule that nginx ignores and that Apache skips under
# "AllowOverride None". A root .env is still read if one exists, but anything
# holding credentials belongs in config/.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://net.akdwk.in

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=akconnect
DB_USER=akconnect
DB_PASS=
DB_PREFIX=

REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@net.akdwk.in
MAIL_SECURE=tls
